{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Variables que cambian el ARTEFACTO, no solo el runtime: `next.config.ts`
      // inlinea `API_URL` en el bundle (`env: { API_URL }`) y Next inlinea las
      // `NEXT_PUBLIC_*`. Turborepo corre en modo estricto: filtra toda variable no
      // declarada y la deja fuera del hash de cache, así que sin esta lista un
      // cambio de valor en Vercel devolvería un build viejo apuntando a otra API.
      "env": ["API_URL", "NEXT_PUBLIC_*"],
      // `.env.local` está gitignoreado y turbo no lo hashea por defecto: sin esto, cambiar
      // `API_URL` en `apps/web/.env.local` devolvería un build cacheado con la URL vieja.
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    // `next build` regenera `.next/types/**`, que el `tsc` del web incluye: si corren en
    // paralelo, `typecheck` lee archivos a medio escribir (`Cannot find module './routes.js'`).
    // Se serializan: el build del web espera a su typecheck.
    "@scout/web#build": {
      "dependsOn": ["^build", "@scout/web#typecheck"],
      "env": ["API_URL", "NEXT_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    // Variables de RUNTIME (no cambian el artefacto, quedan fuera del hash): sin
    // `passThroughEnv`, el modo estricto las filtra y `PORT=… pnpm dev` o un
    // `DATABASE_URL` exportado en la shell/CI se perderían en silencio.
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "DATABASE_URL", "TEST_DATABASE_URL", "JWT_*", "E2E_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "FRONTEND_URL", "DATABASE_URL", "JWT_*", "API_URL"]
    }
  }
}
