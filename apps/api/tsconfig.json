{
  "extends": "@scout/config/tsconfig/nestjs.json",
  "compilerOptions": {
    "resolvePackageJsonExports": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Diferencias con el preset, para no cambiar el resultado del typecheck en la
    // migración al monorepo (MONOREPO.md §Deuda): el código del api no fue escrito
    // con estas dos banderas (equivale al default `false` del original).
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false
  }
}
