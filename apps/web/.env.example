# URL base de la API NestJS. Dev: backend local. NUNCA producción desde dev/e2e.
# En Vercel (Services, api y web en el mismo dominio) va la ruta relativa: API_URL=/api/v1
API_URL=http://localhost:3001/api/v1

# Credenciales del usuario con el que corren los e2e (backend local). Nunca commitear valores.
E2E_EMAIL=
E2E_PASSWORD=
