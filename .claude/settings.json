{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm setup:worktree)",
      "Bash(pnpm turbo run typecheck lint test build)",
      "Bash(pnpm turbo run build)",
      "Bash(pnpm --filter @scout/api test)",
      "Bash(pnpm --filter @scout/api typecheck)",
      "Bash(pnpm --filter @scout/api lint)",
      "Bash(pnpm --filter @scout/api build)",
      "Bash(pnpm --filter @scout/web test)",
      "Bash(pnpm --filter @scout/web typecheck)",
      "Bash(pnpm --filter @scout/web lint)",
      "Bash(pnpm --filter @scout/web build)",
      "Bash(pnpm --filter @scout/shared test)",
      "Bash(pnpm --filter @scout/shared typecheck)",
      "Bash(pnpm --filter @scout/shared lint)",
      "Bash(pnpm --filter @scout/shared build)",
      "Bash(pnpm --filter @scout/config test)",
      "Bash(pnpm --filter @scout/config typecheck)",
      "Bash(pnpm --filter @scout/config lint)",
      "Bash(pnpm --filter @scout/config build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push:*)",
      "Bash(pnpm --filter @scout/api migration:run:*)",
      "Bash(pnpm --filter @scout/api migration:revert:*)",
      "Bash(pnpm --filter @scout/api seed:*)",
      "Bash(pnpm --filter @scout/api benchmark:*)",
      "Bash(pnpm --filter @scout/api db:test:reset:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",
      "Bash(*migration:run*)",
      "Bash(*migration:revert*)",
      "Bash(*db:test:reset*)",
      "Bash(*test:e2e*)",
      "Bash(*benchmark*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh"
          }
        ]
      }
    ]
  }
}
